# Database (Neon via Vercel Marketplace). DATABASE_URL is pooled; DIRECT_URL is for migrations.
DATABASE_URL=
DIRECT_URL=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# App login (Auth.js, GitHub provider). AUTH_SECRET: `openssl rand -base64 32`
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Public origin for OAuth redirects (use your tunnel URL locally; Slack requires https)
APP_URL=

# Encrypts OAuth tokens at rest (AES-256-GCM): `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=

# Slack app (user-token scopes) and Events API signing secret
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Google OAuth client (one grant covers Gmail and Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App for the integration (not the app-login one)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Daily brief (Claude). Optional: without a key the rule-based brief is used.
ANTHROPIC_API_KEY=
# BRIEF_MODEL=claude-opus-5-5

# Background sync + push notifications
# CRON_SECRET: `openssl rand -hex 32`; the scheduled workflow sends it as a Bearer token.
CRON_SECRET=
# Web Push: `npx web-push generate-vapid-keys`. Subject is a mailto: or https: URL.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
